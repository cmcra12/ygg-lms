# Postgres connection string. Point this at Supabase in production:
#   Supabase dashboard → Connect → Session pooler (or Transaction pooler on
#   serverless hosts like Vercel). Looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Leave unset for local development — the app runs an embedded Postgres
# (PGlite) that persists to data/pgdata with zero setup.
# DATABASE_URL=

# Integration drivers: "mock" today, swap to the real driver name once built.
# See README — Integrations for the swap procedure.
XERO_DRIVER=mock
ZEPTO_DRIVER=mock
PPSR_DRIVER=mock
CREDIT_BUREAU_DRIVER=mock
INFO_AGENT_DRIVER=mock
ID_VERIFICATION_DRIVER=mock
